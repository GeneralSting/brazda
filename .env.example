# direct connection, used by drizzle-kit for migrations
DATABASE_URL=
# pooled connection (host with -pooler), used by the running application
DATABASE_URL_POOLED=

# secret that signs sessions, at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# address the application is opened at
BETTER_AUTH_URL=http://localhost:3000
# key of Resend, which sends the emails - empty in development prints them in the terminal
RESEND_API_KEY=
# sender of the emails, the test address of Resend reaches only the owner of its account
# until our domain is verified there
EMAIL_FROM=Brazda <onboarding@resend.dev>

# header the hosting puts the client IP in, comma separated (cf-connecting-ip on Cloudflare,
# x-nf-client-connection-ip on Netlify), empty keeps x-forwarded-for - without a trusted IP
# every visitor shares one rate limit
AUTH_IP_HEADERS=
