# Fake values of the right shape for every variable getServerEnv checks, none of them real,
# so this file is committed. Every test runs with them, the integration tests put the Neon
# test branch of .env.test.local on top. The database address leads nowhere, so a unit test
# that reaches the database fails at once instead of writing into the development data
DATABASE_URL_POOLED=postgresql://unit:tests@127.0.0.1:1/no-database
BETTER_AUTH_SECRET=a-secret-for-unit-tests-only-32-chars
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=000000000000-unit-tests.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-unit-tests
