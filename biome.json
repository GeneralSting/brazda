{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!**/src/app/routeTree.gen.ts", "!**/.cta.json"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["src/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"#/app",
											"#/app/**",
											"#/features",
											"#/features/**"
										],
										"message": "Shared code must not import from app or features."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#/app", "#/app/**"],
										"message": "Features must not import from app."
									},
									{
										"group": ["#/features", "#/features/**"],
										"message": "Features must not import each other. Use relative imports inside a feature and move code used by several features to src/shared."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/app/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#/features/*/**"],
										"message": "Import a feature only through its index.ts, e.g. #/features/parcels."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
